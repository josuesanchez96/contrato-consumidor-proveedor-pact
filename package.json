{
  "name": "consumer-driven-contract-testing-pactv3",
  "version": "1.0.0",
  "description": "Consumer-Driven Contract Testing demo with PactV3, Vitest, and TypeScript for Reservation and Inventory services",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:consumer": "vitest run test/consumer.spec.ts",
    "test:provider": "vitest run test/provider.spec.ts"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^13.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
